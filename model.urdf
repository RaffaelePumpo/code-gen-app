<?xml version="1.0"?>
<robot name="single_pendulum">

    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="100"/>
            <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
        </inertial>

        <collision>
            <origin xyz="0 0 1" rpy="0 0 0"/>
            <geometry>
                <box size="0.15 0.15 2.15"/>
            </geometry>
        </collision>

        <visual>
            <origin xyz="0 0 1" rpy="0 0 0"/>
            <geometry>
                <box size="0.15 0.15 2.15"/>
            </geometry>
        </visual>
    </link>

    <link name="world"/>
    <joint name="fixed_base" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        </joint>

    <link name="upper_link">
        <inertial>
            <origin xyz="0 0 0.5" rpy="0 0 0"/>
            <mass value="1"/>
            <inertia ixx="0.0852" ixy="0" ixz="0" iyy="0.0852" iyz="0" izz="0.0037"/>
        </inertial>

        <collision>
            <origin xyz="0 0 0.5" rpy="0 0 0"/>
            <geometry>
                <box size="0.15 0.15 1.0"/>
            </geometry>
        </collision>

        <visual>
            <origin xyz="0 0 0.5" rpy="0 0 0"/>
            <geometry>
                <box size="0.15 0.15 1.0"/>
            </geometry>
        </visual>
    </link>

    <joint name="upper_joint" type="revolute">
        <parent link="base_link"/>
        <child link="upper_link"/>
        <origin xyz="0.15 0 2" rpy="-1.5708 0 0"/>
        
        <axis xyz="1 0 0"/>
        
        <limit lower="-5" upper="5" effort="100" velocity="100"/>
        
        <dynamics damping="0.0" friction="0.0"/> 
        </joint>
        <gazebo>
                <plugin name="gzyarp::ControlBoard" filename="gz-sim-yarp-controlboard-system">
            <yarpConfigurationFile>
                conf/gazebo_controlboard.ini
            </yarpConfigurationFile>
            <!-- This initialConfiguration is specified here, but it is overriden in single_pendulum_world
                 to show how to spawn the model in a different configuration from the default one of the model -->
            <initialConfiguration>0.0</initialConfiguration>
        </plugin>
        <plugin name="gzyarp::RobotInterface" filename="gz-sim-yarp-robotinterface-system">
            <yarpRobotInterfaceConfigurationFile>
                conf/single_pendulum_nws.xml
            </yarpRobotInterfaceConfigurationFile>
        </plugin>
        </gazebo>
</robot>